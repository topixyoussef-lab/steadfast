# Steadfast moderation service.
# Copy to backend/.env and fill in. Never commit the real file.

# Shared secret. The Next.js route handlers send this as X-API-Token.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me

# Comma-separated browser origins allowed to call the service.
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# lexicon = fully local, free, deterministic, always on.
# gemini  = Gemini judges every message; the lexicon still runs and decides
#           whenever Gemini is throttled, late, safety-filtered or unreadable.
# hybrid  = lexicon first, OpenAI as a second opinion on risky messages.
# openai  = OpenAI only. Not recommended for a safety-critical MVP.
MODERATION_MODE=lexicon

# Only read when MODERATION_MODE=gemini. Get one at
# https://aistudio.google.com/apikey and keep it out of the repo.
GEMINI_API_KEY=
# gemini-flash-latest and the numbered flash models were unusable on this
# project's key (503 high demand, 429 quota). flash-lite answers in ~900 ms.
GEMINI_MODEL=gemini-flash-lite-latest
# Must stay under the 4 s the Next.js client allows for the whole call
# (src/lib/python-client.ts TIMEOUT_MS). Past that the client gives up and
# chat fails closed, which is worse than a lexicon-only verdict.
GEMINI_TIMEOUT_SECONDS=2.0
# After one failure the service stops asking Gemini for this long and answers
# from the lexicon, so a throttled key is not in every member's critical path.
GEMINI_COOLDOWN_SECONDS=30

# Leave empty to stay local-only.
OPENAI_API_KEY=
OPENAI_MODEL=omni-moderation-latest

# Only used in hybrid mode, and only after the lexicon flags or blocks.
HYBRID_ESCALATE_SCORE=0.4

# Never let a slow third party block a member from posting.
OPENAI_TIMEOUT_SECONDS=2.5

# Mirrors the Postgres CHECK on chat_messages.content.
MAX_MESSAGE_CHARS=2000

# "production" hides /docs and /openapi.json. Set it on anything public: this is
# an internal API, and its schema is exactly what a prober would want.
ENVIRONMENT=development
